{
  "name": "gelatino-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test lib/test/unit/*.test.js",
    "test:emulator": "npm run build && node --test --test-concurrency=1 lib/test/emulator/*.test.js",
    "seed:e2e": "npm run build && node lib/test/seed/e2e_seed.js",
    "test:e2e": "bash ../tool/run_web_e2e.sh"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "typescript": "7.0.2"
  }
}
